{
    "name": "maatify/php-eligibility-consumer-harness",
    "description": "External Composer consumer fixture for maatify/php-eligibility.",
    "type": "project",
    "repositories": [
        {
            "type": "path",
            "url": "..",
            "options": {
                "symlink": false,
                "versions": {
                    "maatify/php-eligibility": "dev-rc2-current-source"
                }
            }
        }
    ],
    "require": {
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "maatify/php-eligibility": "dev-rc2-current-source",
        "php": "^8.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
