{
    "name": "maatify/php-eligibility",
    "description": "Framework-neutral eligibility rules and typed decisions for Maatify applications.",
    "keywords": [
        "eligibility",
        "maatify",
        "php"
    ],
    "homepage": "https://github.com/Maatify/php-eligibility",
    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "Maatify",
            "email": "support@maatify.dev",
            "homepage": "https://maatify.dev"
        }
    ],
    "support": {
        "issues": "https://github.com/Maatify/php-eligibility/issues",
        "source": "https://github.com/Maatify/php-eligibility"
    },
    "autoload": {
        "psr-4": {
            "Maatify\\Eligibility\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Maatify\\Eligibility\\Tests\\": "tests/"
        }
    },
    "require": {
        "ext-pcre": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "maatify/exceptions": "^1.0",
        "maatify/persistence": "^1.4",
        "php": "^8.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^12.0"
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=1G",
        "check:local": "bash tools/check-local.sh",
        "check:style": "php-cs-fixer fix --dry-run --diff",
        "format": "php-cs-fixer fix",
        "lint:php": "@php tools/php-lint.php",
        "check:composer-policy": "php tools/check-composer-policy.php",
        "test": "bash tools/run-integration.sh full",
        "test:golden": "phpunit --testsuite golden",
        "test:examples": "bash tools/run-integration.sh examples",
        "test:harness": "bash tools/run-integration.sh harness",
        "test:integration": "bash tools/run-integration.sh integration",
        "test:unit": "phpunit --testsuite unit"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.4.0"
        },
        "policy": {
            "advisories": {
                "block": true,
                "audit": "fail"
            },
            "malware": {
                "block": true,
                "block-scope": "all",
                "audit": "fail"
            },
            "abandoned": {
                "block": false,
                "audit": "fail"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
